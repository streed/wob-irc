# Docker Environment Configuration
# Copy this file to .env and customize for your setup

# IRC Configuration
IRC_HOST=irc.libera.chat
IRC_PORT=6667
IRC_NICK=ollama-bot
IRC_USERNAME=ollama
IRC_REALNAME=Ollama IRC Bot
IRC_CHANNELS=#test,#mychannel
IRC_TLS=false

# Ollama Configuration
# For local Ollama (using the service name from docker-compose):
OLLAMA_HOST=http://ollama:11434
# For Ollama cloud models, uncomment and set:
# OLLAMA_HOST=https://api.ollama.ai
# OLLAMA_API_KEY=your-ollama-api-key

OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
MAX_CONTEXT_TOKENS=4096
MAX_TOOL_CALL_ROUNDS=10
DISABLE_THINKING=false

# Bot Configuration
MESSAGE_DEBOUNCE_MS=2000
SYSTEM_PROMPT=You are a helpful IRC bot assistant. You respond to messages in a concise and friendly manner. Keep your responses brief and appropriate for IRC chat.

# Database Configuration (handled by docker-compose, no need to change)
# MESSAGE_HISTORY_DB_PATH=/app/data/message-history.db

# Chaos Mode Configuration
CHAOS_MODE_ENABLED=false
CHAOS_MODE_PROBABILITY=0.1

# Debug Configuration
IRC_DEBUG=false